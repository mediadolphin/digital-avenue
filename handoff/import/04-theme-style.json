{
  "label": "Digital Avenue",
  "settings": {
    "_custom": true,
    "conditions": {
      "conditions": [
        {
          "id": "daglob1",
          "main": "any"
        }
      ]
    },
    "typography": {
      "typographyHtml": "100%",
      "typographyBody": {
        "font-family": "Manrope",
        "font-size": "var(--da-text-base)",
        "line-height": "var(--da-leading-normal)",
        "color": {
          "raw": "var(--da-text)"
        }
      },
      "typographyHeadings": {
        "font-family": "Manrope",
        "line-height": "var(--da-leading-tight)",
        "letter-spacing": "var(--da-tracking-tight)",
        "color": {
          "raw": "var(--da-text)"
        }
      },
      "typographyHeadingH1": {
        "font-size": "var(--da-text-xl)",
        "font-weight": "800",
        "line-height": "1.14",
        "letter-spacing": "-0.03em"
      },
      "h1Margin": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "typographyHeadingH2": {
        "font-size": "clamp(28px, 3.4vw, 44px)",
        "font-weight": "700",
        "line-height": "1.1",
        "letter-spacing": "-0.03em"
      },
      "h2Margin": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "typographyHeadingH3": {
        "font-size": "var(--da-text-h3)",
        "font-weight": "700",
        "line-height": "var(--da-leading-snug)",
        "letter-spacing": "-0.015em"
      },
      "h3Margin": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "typographyHeadingH4": {
        "font-size": "var(--da-text-md)",
        "font-weight": "600",
        "line-height": "var(--da-leading-snug)",
        "letter-spacing": "0"
      },
      "h4Margin": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "typographyHeadingH5": {
        "font-size": "var(--da-text-base)",
        "font-weight": "700",
        "line-height": "var(--da-leading-snug)",
        "letter-spacing": "0"
      },
      "h5Margin": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "typographyHeadingH6": {
        "font-size": "var(--da-text-xs)",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "text-transform": "uppercase",
        "line-height": "var(--da-leading-snug)",
        "color": {
          "raw": "var(--da-muted)"
        }
      },
      "h6Margin": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "typographyLead": {
        "font-size": "var(--da-text-md)",
        "line-height": "1.55",
        "color": {
          "raw": "var(--da-muted)"
        }
      },
      "focusOutline": "2px solid var(--da-teal)"
    },
    "colors": {
      "colorPrimary": {
        "raw": "var(--da-teal)"
      },
      "colorSecondary": {
        "raw": "var(--da-sand)"
      },
      "colorLight": {
        "raw": "var(--da-bg)"
      },
      "colorDark": {
        "raw": "var(--da-text)"
      },
      "colorMuted": {
        "raw": "var(--da-muted)"
      },
      "colorBorder": {
        "raw": "var(--da-border)"
      },
      "colorInfo": {
        "raw": "var(--da-teal)"
      },
      "colorSuccess": {
        "raw": "var(--da-success)"
      },
      "colorWarning": {
        "raw": "var(--da-warning)"
      },
      "colorDanger": {
        "raw": "var(--da-error)"
      }
    },
    "general": {
      "containerMaxWidth": "1240px",
      "sectionPadding": {
        "top": "var(--da-sp-20)",
        "right": "var(--da-sp-6)",
        "bottom": "var(--da-sp-20)",
        "left": "var(--da-sp-6)"
      },
      "siteBackground": {
        "color": {
          "raw": "var(--da-bg)"
        }
      }
    },
    "links": {
      "typography": {
        "color": {
          "raw": "var(--da-teal)"
        }
      },
      "textDecoration": "none",
      "transition": "color var(--da-t)"
    },
    "button": {
      "typography": {
        "font-family": "Manrope",
        "font-size": "15px",
        "font-weight": "700",
        "line-height": "1",
        "letter-spacing": "0.01em",
        "color": {
          "raw": "#ffffff"
        }
      },
      "background": {
        "raw": "var(--da-teal-fill)"
      },
      "border": {
        "width": {
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0"
        },
        "style": "none",
        "radius": {
          "top": "var(--da-r-md)",
          "right": "var(--da-r-md)",
          "bottom": "var(--da-r-md)",
          "left": "var(--da-r-md)"
        }
      },
      "transition": "background var(--da-t), transform var(--da-t), box-shadow var(--da-t), color var(--da-t)",
      "primaryBackground": {
        "raw": "var(--da-teal-fill)"
      },
      "primaryTypography": {
        "color": {
          "raw": "#ffffff"
        }
      },
      "primaryBorder": {
        "width": {
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0"
        },
        "style": "none",
        "radius": {
          "top": "var(--da-r-md)",
          "right": "var(--da-r-md)",
          "bottom": "var(--da-r-md)",
          "left": "var(--da-r-md)"
        }
      },
      "secondaryBackground": {
        "raw": "var(--da-sand)"
      },
      "secondaryTypography": {
        "color": {
          "raw": "var(--da-teal-dark)"
        }
      },
      "secondaryBorder": {
        "width": {
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0"
        },
        "style": "none",
        "radius": {
          "top": "var(--da-r-md)",
          "right": "var(--da-r-md)",
          "bottom": "var(--da-r-md)",
          "left": "var(--da-r-md)"
        }
      },
      "lightBackground": {
        "raw": "#ffffff"
      },
      "lightTypography": {
        "color": {
          "raw": "var(--da-teal-dark)"
        }
      },
      "lightBorder": {
        "width": {
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0"
        },
        "style": "none",
        "radius": {
          "top": "var(--da-r-md)",
          "right": "var(--da-r-md)",
          "bottom": "var(--da-r-md)",
          "left": "var(--da-r-md)"
        }
      },
      "outlineBackground": {
        "raw": "transparent"
      },
      "outlineBorder": {
        "width": {
          "top": "1.5px",
          "right": "1.5px",
          "bottom": "1.5px",
          "left": "1.5px"
        },
        "style": "solid",
        "color": {
          "raw": "var(--da-teal)"
        },
        "radius": {
          "top": "var(--da-r-md)",
          "right": "var(--da-r-md)",
          "bottom": "var(--da-r-md)",
          "left": "var(--da-r-md)"
        }
      },
      "outlineTypography": {
        "color": {
          "raw": "var(--da-teal)"
        }
      }
    },
    "form": {
      "labelTypography": {
        "font-size": "var(--da-text-xs)",
        "font-weight": "700",
        "letter-spacing": "0.06em",
        "text-transform": "uppercase",
        "color": {
          "raw": "var(--da-muted)"
        }
      },
      "placeholderTypography": {
        "color": {
          "raw": "var(--da-muted)"
        }
      },
      "fieldTypography": {
        "font-family": "Manrope",
        "font-size": "var(--da-text-base)",
        "color": {
          "raw": "var(--da-text)"
        }
      },
      "fieldBackgroundColor": {
        "raw": "var(--da-bg)"
      },
      "fieldBorder": {
        "width": {
          "top": "1px",
          "right": "1px",
          "bottom": "1px",
          "left": "1px"
        },
        "style": "solid",
        "color": {
          "raw": "var(--da-border)"
        },
        "radius": {
          "top": "var(--da-r-md)",
          "right": "var(--da-r-md)",
          "bottom": "var(--da-r-md)",
          "left": "var(--da-r-md)"
        }
      },
      "fieldPadding": {
        "top": "12px",
        "right": "14px",
        "bottom": "12px",
        "left": "14px"
      },
      "fieldMargin": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      },
      "submitButtonPadding": {
        "top": "13px",
        "right": "26px",
        "bottom": "13px",
        "left": "26px"
      },
      "submitButtonTypography": {
        "font-weight": "700",
        "font-size": "15px",
        "letter-spacing": "0.01em",
        "color": {
          "raw": "#ffffff"
        }
      },
      "submitButtonBackgroundColor": {
        "raw": "var(--da-teal-fill)"
      },
      "submitButtonBorder": {
        "width": {
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0"
        },
        "style": "none",
        "radius": {
          "top": "var(--da-r-md)",
          "right": "var(--da-r-md)",
          "bottom": "var(--da-r-md)",
          "left": "var(--da-r-md)"
        }
      }
    }
  },
  "id": "digital_avenue"
}
